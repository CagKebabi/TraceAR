{
  "name": "@tracear/sdk",
  "version": "0.1.1",
  "description": "High-performance, jitter-free image tracking for the mobile web — a WASM+SIMD AR engine",
  "type": "module",
  "license": "MIT",
  "author": "Ahmet Güleş",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CagKebabi/TraceAR.git"
  },
  "homepage": "https://github.com/CagKebabi/TraceAR#readme",
  "bugs": "https://github.com/CagKebabi/TraceAR/issues",
  "keywords": ["ar", "webar", "image-tracking", "augmented-reality", "wasm", "computer-vision", "three", "mindar-alternative"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "default": "./dist/three.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    }
  },
  "bin": {
    "tracear": "bin/tracear.mjs"
  },
  "files": ["dist", "bin", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^5.5.0"
  }
}
